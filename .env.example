APP_NAME="TaskFlow API"
APP_VERSION="0.1.0"
APP_DESCRIPTION="REST API for collaborative project and task management"

ENVIRONMENT=development
DEBUG=true

API_V1_PREFIX=/api/v1

# PostgreSQL
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=replace-with-a-secure-random-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# generate with: `openssl rand -hex 32`
JWT_SECRET_KEY=replace-with-a-unique-secret-generated-with-openssl
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
